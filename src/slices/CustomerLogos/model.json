{
  "id": "company_carousel",
  "type": "SharedSlice",
  "name": "CustomerLogos",
  "description": "A carousel displaying company logos",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default company carousel",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Title",
            "placeholder": "Carousel section title (rich text)",
            "allowTargetBlank": true,
            "multi": "heading2"
          }
        },
        "title_text": {
          "type": "Text",
          "config": {
            "label": "Title Text",
            "placeholder": "Plain text title (if needed for component props)"
          }
        },
        "class_string": {
          "type": "Text",
          "config": {
            "label": "CSS Class String",
            "placeholder": "Optional CSS classes to apply"
          }
        }
      },
      "items": {
        "company_logo": {
          "type": "Image",
          "config": {
            "label": "Company Logo",
            "constraint": {},
            "thumbnails": []
          }
        },
        "company_name": {
          "type": "Text",
          "config": {
            "label": "Company Name",
            "placeholder": "Name of the company (used as alt text)"
          }
        }
      }
    }
  ]
}