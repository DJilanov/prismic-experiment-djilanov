{
  "id": "faq_section",
  "type": "SharedSlice",
  "name": "FAQSection",
  "description": "A section containing multiple FAQ questions",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default FAQ section",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Title",
            "placeholder": "FAQ section title",
            "allowTargetBlank": true,
            "multi": "heading2"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "placeholder": "Section description text",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "fetch_questions": {
          "type": "Boolean",
          "config": {
            "label": "Fetch Questions",
            "placeholder": "Fetch questions from a central FAQ document",
            "default_value": false
          }
        },
        "faq_content_type": {
          "type": "Text",
          "config": {
            "label": "FAQ Content Type",
            "placeholder": "Content type ID to fetch questions from"
          }
        }
      },
      "items": {
        "question": {
          "type": "StructuredText",
          "config": {
            "label": "Question",
            "placeholder": "FAQ question text",
            "allowTargetBlank": true,
            "multi": "heading5"
          }
        },
        "question_mobile": {
          "type": "StructuredText",
          "config": {
            "label": "Question (Mobile)",
            "placeholder": "FAQ question text for mobile",
            "allowTargetBlank": true,
            "multi": "heading3"
          }
        },
        "answer": {
          "type": "StructuredText",
          "config": {
            "label": "Answer",
            "placeholder": "FAQ answer text",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "start_open": {
          "type": "Boolean",
          "config": {
            "label": "Start Open",
            "placeholder": "Should this question be expanded by default",
            "default_value": false
          }
        }
      }
    }
  ]
}