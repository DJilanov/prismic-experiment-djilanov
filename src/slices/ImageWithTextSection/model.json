{
  "id": "image_with_text_section",
  "type": "SharedSlice",
  "name": "ImageWithTextSection",
  "description": "A section with an image and text side by side",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default image with text section",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Title",
            "placeholder": "Section title",
            "allowTargetBlank": true,
            "multi": "heading2"
          }
        },
        "header": {
          "type": "StructuredText",
          "config": {
            "label": "Header",
            "placeholder": "Section header",
            "allowTargetBlank": true,
            "multi": "heading6"
          }
        },
        "text": {
          "type": "StructuredText",
          "config": {
            "label": "Text",
            "placeholder": "Main text content",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "Image Position",
            "placeholder": "Position of the image",
            "options": ["left", "right"],
            "default_value": "right"
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_alt": {
          "type": "Text",
          "config": {
            "label": "Image Alt Text",
            "placeholder": "Alternative text for the image"
          }
        },
        "section_id": {
          "type": "Text",
          "config": {
            "label": "Section ID",
            "placeholder": "Optional HTML ID for the section"
          }
        }
      },
      "items": {
        "content": {
          "type": "StructuredText",
          "config": {
            "label": "Additional Content",
            "placeholder": "Additional content items (optional)",
            "allowTargetBlank": true,
            "multi": "paragraph,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item"
          }
        }
      }
    }
  ]
}